        config MCUX_DEPENDENCY_COMPONENT_middleware.wifi.mlan_sdio_DEPEND_ANYOF_OPTION_1
            bool "Component MCUX_DEPENDENCY_COMPONENT_middleware.wifi.mlan_sdio_DEPEND_ANYOF_OPTION_1"

        config MCUX_DEPENDENCY_COMPONENT_middleware.wifi.mlan_sdio_DEPEND_ANYOF_OPTION_2
            bool "Component MCUX_DEPENDENCY_COMPONENT_middleware.wifi.mlan_sdio_DEPEND_ANYOF_OPTION_2"

      endchoice
    endif

